* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 10px;
  background-color: #ffffff;
  color: #111111;
  font-family: "Malgun Gothic", sans-serif;
  font-size: 16px;
}

.apply-form {
  width: 528px;
}

fieldset {
  width: 100%;
  height: 102px;
  margin: 0 0 9px;
  padding: 16px 14px;
  border: 1px solid #777777;
}

legend {
  padding: 0 3px;
  font-size: 16px;
}

p {
  margin: 9px 0 14px;
  font-size: 16px;
}

.option-group {
  display: flex;
  align-items: center;
  gap: 9px;
}

.option-group label {
  display: flex;
  align-items: center;
  gap: 2px;
  cursor: pointer;
}

input[type="radio"],
input[type="checkbox"] {
  width: 14px;
  height: 14px;
  margin: 0;
  accent-color: #1683f8;
}